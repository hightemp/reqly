// ===== GET with query and auth =====
import axios from 'axios';

const { data } = await axios.request({
  method: 'GET',
  url: 'https://api.example.com/users?page=1&q=a%20b',
  headers: {
    'Accept': 'application/json',
    'Authorization': 'Bearer t0k\'en"$x'
  }
});

console.log(data);

// ===== POST JSON =====
import axios from 'axios';

const { data } = await axios.request({
  method: 'POST',
  url: 'https://api.example.com/users',
  headers: {
    'Content-Type': 'application/json'
  },
  data: {
  "name": "Ann",
  "tags": [
    "a"
  ]
}
});

console.log(data);

// ===== PUT form =====
import axios from 'axios';

const body = new URLSearchParams();
body.append('a', '1');
body.append('b', 'x y&z');
const { data } = await axios.request({
  method: 'PUT',
  url: 'http://localhost:8080/form',
  headers: {
    'Content-Type': 'application/x-www-form-urlencoded'
  },
  data: body
});

console.log(data);

// ===== POST multipart =====
import axios from 'axios';

const body = new FormData();
body.append('title', 'Hello');
body.append('file', fileInput.files[0]); // /tmp/a.png
const { data } = await axios.request({
  method: 'POST',
  url: 'https://api.example.com/upload',
  headers: {},
  data: body
});

console.log(data);

// ===== PATCH file =====
import axios from 'axios';

const { data } = await axios.request({
  method: 'PATCH',
  url: 'https://api.example.com/raw',
  headers: {
    'Content-Type': 'application/octet-stream'
  },
  data: fileInput.files[0] /* /tmp/data.bin */
});

console.log(data);
