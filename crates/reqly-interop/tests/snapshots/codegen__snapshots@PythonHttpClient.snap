// ===== GET with query and auth =====
import http.client

conn = http.client.HTTPSConnection("api.example.com")
headers = {
  "Accept": "application/json",
  "Authorization": "Bearer t0k'en\"$x"
}
conn.request("GET", "/users?page=1&q=a%20b", headers=headers)
res = conn.getresponse()
print(res.read().decode())

// ===== POST JSON =====
import http.client

conn = http.client.HTTPSConnection("api.example.com")
headers = {
  "Content-Type": "application/json"
}
payload = "{\"name\":\"Ann\",\"tags\":[\"a\"]}"
conn.request("POST", "/users", body=payload, headers=headers)
res = conn.getresponse()
print(res.read().decode())

// ===== PUT form =====
import http.client

conn = http.client.HTTPConnection("localhost:8080")
headers = {
  "Content-Type": "application/x-www-form-urlencoded"
}
payload = "a=1&b=x+y%26z"
conn.request("PUT", "/form", body=payload, headers=headers)
res = conn.getresponse()
print(res.read().decode())

// ===== POST multipart =====
import http.client

conn = http.client.HTTPSConnection("api.example.com")
headers = {}
boundary = "----ReqlyFormBoundary7MA4YWxk"
parts = []
parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\n".encode() + "Hello".encode() + b"\r\n")
parts.append(f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a.png\"\r\n\r\n".encode())
parts.append(open("/tmp/a.png", "rb").read() + b"\r\n")
parts.append(f"--{boundary}--\r\n".encode())
payload = b"".join(parts)
headers["Content-Type"] = f"multipart/form-data; boundary={boundary}"
conn.request("POST", "/upload", body=payload, headers=headers)
res = conn.getresponse()
print(res.read().decode())

// ===== PATCH file =====
import http.client

conn = http.client.HTTPSConnection("api.example.com")
headers = {
  "Content-Type": "application/octet-stream"
}
payload = open("/tmp/data.bin", "rb").read()
conn.request("PATCH", "/raw", body=payload, headers=headers)
res = conn.getresponse()
print(res.read().decode())
