---
source: crates/reqly-interop/tests/postman.rs
expression: "files[0].content"
---
{
  "info": {
    "name": "Example API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sample"
  },
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"user\": \"{{user}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Logs in."
      },
      "response": [],
      "variable": [
        {
          "key": "user",
          "value": "admin",
          "type": "string"
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users?page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "debug",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{% response 'body', 'req-login', '$.token', 'no-history' %}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "upload"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "a",
                  "value": "1"
                },
                {
                  "key": "b",
                  "value": "{{$guid}}"
                }
              ]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "description": "User endpoints",
      "auth": {
        "type": "basic",
        "basic": [
          {
            "key": "username",
            "value": "u",
            "type": "string"
          },
          {
            "key": "password",
            "value": "p",
            "type": "string"
          }
        ]
      },
      "variable": [
        {
          "key": "version",
          "value": "v2",
          "type": "string"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.example.com",
      "type": "string"
    },
    {
      "key": "key",
      "value": "secret-key",
      "type": "secret"
    }
  ]
}
